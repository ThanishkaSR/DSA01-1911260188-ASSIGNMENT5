TASK B3 – VIRTUAL FUNCTIONS vs SWITCH vs EXCEPTIONS: THE COST (8 Marks)
B3.1 – Correctness on Small Data (2 Marks)
The same 10 bills were processed using:
1. Virtual functions
2. A Bill structure with a type field and switch statement
Both approaches produce the same total, confirming correctness.

Conclusion: Both methods correctly calculate billing amounts. Virtual functions provide runtime polymorphism, while the switch approach selects the calculation based on the bill type.
B3.2 – Increase the Data Size (2 Marks)
The execution time of both implementations was measured for:
- 1,000 bills
- 1,000,000 bills
- 10,000,000 bills
The programs were compiled using -O2 optimization.
Benchmark code
#include <iostream>
#include <vector>
#include <chrono>
using namespace std;
using namespace chrono;

struct Bill {
    int type;
    double a, b;
};

double switchTotal(const Bill& bill) {
    switch (bill.type) {
        case 1: return bill.a + bill.b;
        case 2: return bill.a * bill.b;
        default: return 0;
    }
}

class BaseBill {
public:
    virtual double total() const = 0;
    virtual ~BaseBill() = default;
};

class OPBill : public BaseBill {
    double consultation, tests;
public:
    OPBill(double c, double t) : consultation(c), tests(t) {}
    double total() const override {
        return consultation + tests;
    }
};

class IPBill : public BaseBill {
    double days, rate;
public:
    IPBill(double d, double r) : days(d), rate(r) {}
    double total() const override {
        return days * rate;
    }
};

int main() {
    int sizes[] = {1000, 1000000, 10000000};

    for (int n : sizes) {
        vector<Bill> bills;
        vector<OPBill> op;
        vector<IPBill> ip;
        vector<BaseBill*> ptr;

        bills.reserve(n);
        op.reserve(n);
        ip.reserve(n);
        ptr.reserve(n);

        for (int i = 0; i < n; i++) {
            if (i % 2 == 0) {
                bills.push_back({1, 500, 1200});
                op.emplace_back(500, 1200);
            } else {
                bills.push_back({2, 3, 2500});
                ip.emplace_back(3, 2500);
            }
        }

        // Create polymorphic objects
        for (int i = 0; i < n; i++) {
            if (i % 2 == 0)
                ptr.push_back(&op[i / 2]);
            else
                ptr.push_back(&ip[i / 2]);
        }

        double sum1 = 0, sum2 = 0;

        auto start1 = high_resolution_clock::now();

        for (const Bill& b : bills)
            sum1 += switchTotal(b);

        auto end1 = high_resolution_clock::now();

        auto start2 = high_resolution_clock::now();

        for (BaseBill* b : ptr)
            sum2 += b->total();

        auto end2 = high_resolution_clock::now();

        cout << "\nBills: " << n << '\n';
        cout << "Switch total: " << sum1 << '\n';
        cout << "Virtual total: " << sum2 << '\n';

        cout << "Switch time: "
             << duration_cast<milliseconds>(end1-start1).count()
             << " ms\n";

        cout << "Virtual time: "
             << duration_cast<milliseconds>(end2-start2).count()
             << " ms\n";
    }
}


